<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BGModdingTool.App.ViewModels"
             xmlns:core="using:BGModdingTool.Core.Models"
             x:Class="BGModdingTool.App.Views.AssetsView"
             x:DataType="vm:AssetsViewModel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="📦 Import archives…" Command="{Binding ImportArchivesCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="📁 Import folder…" Command="{Binding ImportFolderCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="📁 Open pack folder" Command="{Binding OpenFolderCommand}"
                IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <Button Content="🗑 Remove pack" Command="{Binding DeleteCommand}"
                IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
      <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                 Text="Portrait packs, soundsets, music and loose override files — plain archives, no WeiDU. Import once, then deploy to any instance; every deployed file is recorded so it can be removed again."/>
    </StackPanel>

    <Grid ColumnDefinitions="260,12,*">
      <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:AssetPackage">
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock FontSize="11" Opacity="0.7">
                <Run Text="{Binding Kind}"/> · <Run Text="{Binding FileCount}"/> files
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Column="2" RowDefinitions="Auto,*"
            IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">

      <!-- details -->
      <ScrollViewer Grid.Row="0" MaxHeight="330">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Kind:" VerticalAlignment="Center"/>
            <ComboBox Width="140" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                      ToolTip.Tip="Detected automatically from the files; change it if the guess is wrong. Decides the deployment target."/>
          </StackPanel>
          <TextBlock Text="{Binding RelevantFilesInfo}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>

          <Separator/>
          <TextBlock Text="Deploy to instance" FontWeight="Bold"/>
          <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}"
                    PlaceholderText="pick an instance…" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:GameInstance">
                <TextBlock><Run Text="{Binding Name}"/> (<Run Text="{Binding GameType}"/>)</TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding TargetPreview, StringFormat='Target: {0}'}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                     IsVisible="{Binding TargetPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Border IsVisible="{Binding TargetIsOutsideInstance}" CornerRadius="4" Padding="8"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="ℹ Enhanced Edition games read player portraits and soundsets from your Documents folder, not from the game directory — this target is shared by every instance of the same game and is the one place the tool writes outside an instance. Files are tracked and can be removed with Undeploy."/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="⬇ Deploy" Classes="accent" Command="{Binding DeployCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Content="⬆ Undeploy" Command="{Binding UndeployCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Content="📁 Open target" Command="{Binding OpenTargetFolderCommand}"/>
          </StackPanel>

          <Separator/>
          <TextBlock Text="Deployed to" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding DeploymentsOfSelected}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AssetDeploymentItem">
                <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="(not deployed anywhere)" FontSize="12" Opacity="0.6"
                     IsVisible="{Binding !DeploymentsOfSelected.Count}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- preview: thumbnails + audio list -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBlock Text="Preview" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PreviewInfo}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
            <Button Content="⏹ Stop audio" FontSize="11" Padding="6,2" Command="{Binding StopAudioCommand}"/>
          </StackPanel>
          <ScrollViewer>
            <StackPanel Spacing="8">
              <ItemsControl ItemsSource="{Binding ImagePreviews}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssetPreviewItem">
                    <Button Padding="4" Margin="3" Background="Transparent"
                            Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Path}">
                      <StackPanel Width="116" Spacing="2">
                        <Border Width="110" Height="110" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="3">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" ToolTip.Tip="{Binding Name}"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding AudioPreviews}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssetPreviewItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                      <Button Width="34" FontSize="11" Padding="4,2" Command="{Binding PlayCommand}">
                        <Panel>
                          <TextBlock Text="▶" IsVisible="{Binding !IsPlaying}"/>
                          <TextBlock Text="⏸" IsVisible="{Binding IsPlaying}"/>
                        </Panel>
                      </Button>
                      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Path}"/>
                          <TextBlock Text="(external player)" FontSize="11" Foreground="Gray"
                                     IsVisible="{Binding !CanPlayInApp}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlaylistText}" FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding IsMusPlaylist}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeInfo}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
