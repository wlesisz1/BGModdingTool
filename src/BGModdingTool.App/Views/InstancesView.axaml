<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BGModdingTool.App.ViewModels"
             xmlns:core="using:BGModdingTool.Core.Models"
             xmlns:svc="using:BGModdingTool.Core.Services"
             x:Class="BGModdingTool.App.Views.InstancesView"
             x:DataType="vm:InstancesViewModel">
  <Grid ColumnDefinitions="320,12,*" Margin="12">

    <!-- Instance list + creation -->
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
        <TextBox Watermark="New instance name (optional)"
                 Text="{Binding NewInstanceName}" />
        <Button Content="➕ New instance from a game folder…"
                Command="{Binding CreateInstanceCommand}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Text="Game instances" FontWeight="Bold" Margin="0,0,0,6"/>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:GameInstance">
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding GameType}" FontSize="11" Opacity="0.7"/>
              <TextBlock Text="{Binding CurrentStateText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Details -->
    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="10" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding RenameText}" FontSize="18" FontWeight="Bold"/>
          <Button Grid.Column="1" Content="✏ Rename" Margin="6,0,0,0"
                  Command="{Binding RenameInstanceCommand}" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="▶ Launch game" Classes="accent" Command="{Binding LaunchGameCommand}"/>
          <TextBlock Text="with:" VerticalAlignment="Center"/>
          <ComboBox MinWidth="190" ItemsSource="{Binding LaunchExes}" SelectedItem="{Binding SelectedLaunchExe}"
                    ToolTip.Tip="Executable used by Launch game (remembered per instance). With EEex installed the game must be started through InfinityLoader.exe — starting Baldur.exe directly crashes."/>
          <Button Content="📁 Open game folder" Command="{Binding OpenGameFolderCommand}"/>
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Selected.GameType}" />
          <TextBlock Text="{Binding SelectedStateText}" FontWeight="SemiBold" TextWrapping="Wrap"
                     ToolTip.Tip="Which snapshot the game folder equals right now. 'modified after' means an install wrote to it since."/>
          <TextBlock Text="{Binding Selected.SourcePath, StringFormat='Source: {0}'}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Selected.GamePath, StringFormat='Game folder: {0}'}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator/>
        <TextBlock Text="Snapshots (game state versions)" FontWeight="Bold"/>
        <Button Content="📸 Take a snapshot now" Command="{Binding TakeSnapshotCommand}" IsEnabled="{Binding !IsBusy}"/>
        <ItemsControl ItemsSource="{Binding Snapshots}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SnapshotItem">
              <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAtLocal, StringFormat='{}{0:g}'}" FontSize="11" Opacity="0.7"/>
                    <TextBlock Text="{Binding Marker}" FontSize="11" FontWeight="SemiBold" Foreground="Green" IsVisible="{Binding IsCurrent}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="↩ Restore" Margin="4,0"
                          Command="{Binding $parent[ItemsControl].((vm:InstancesViewModel)DataContext).RestoreSnapshotCommand}"
                          CommandParameter="{Binding}"/>
                  <Button Grid.Column="2" Content="🗑"
                          Command="{Binding $parent[ItemsControl].((vm:InstancesViewModel)DataContext).DeleteSnapshotCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="🗑 Delete instance" Command="{Binding RequestDeleteCommand}"
                  IsVisible="{Binding !ConfirmingDelete}"/>
          <Button Content="⚠ Confirm deletion (irreversible)" Classes="accent"
                  Command="{Binding ConfirmDeleteCommand}" IsVisible="{Binding ConfirmingDelete}"/>
          <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" IsVisible="{Binding ConfirmingDelete}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
